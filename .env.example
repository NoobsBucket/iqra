NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_LOGO_URL=
API_URL=
REVALIDATE_SECRET=

# Optional override for the admin session signing key; falls back to R2_SECRET_ACCESS_KEY.
JWT_SECRET=

# Cloudflare R2 server credentials. Never expose these with NEXT_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket custom domain, without a trailing slash (for example https://media.example.com).
R2_PUBLIC_URL=